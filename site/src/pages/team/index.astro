  #lac-dlg .lac-sub { margin: 0; }
  #lac-dlg input[type='search'] { height: 44px; padding: 0 16px; border-radius: 999px; border: 2px solid var(--line); background: #fff; }
  #lac-dlg .selrow { display: flex; align-items: center; gap: 8px; }
  #lac-dlg .selrow label { width: 64px; flex: none; font-size: 13px; font-weight: 700; color: var(--timber); }
