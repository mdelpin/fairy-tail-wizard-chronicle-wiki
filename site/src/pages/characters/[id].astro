---
import Base from '../../layouts/Base.astro';
import MagicCircle from '../../components/MagicCircle.astro';
import Pennant from '../../components/Pennant.astro';
import Kanji from '../../components/Kanji.astro';
import {
  units, applications, effects, lacrimaById, ATTR, KIND_ORDER, url, portraits, initials, LAUNCH_DAY, dayText,
  baseName, valueText, familyKey, WIKI_CREDIT, bannerById, bannerDates, unitDates, DATE_NOTE, roleIcon, skillIcon,
  COLLECTION_BONUS_PCT, COLLECTION_LEVEL_STEPS, COLLECTION_AWAKEN_STEPS, type Unit, type Effect,
} from '../../lib/data';

export function getStaticPaths() {
  return units.map((u) => ({ params: { id: u.id }, props: { unit: u } }));
}
const { unit } = Astro.props as { unit: Unit };
const a = ATTR[unit.attribute];
const skills = unit.skills.slice().sort((x, y) => KIND_ORDER.indexOf(x.kind) - KIND_ORDER.indexOf(y.kind));
const UNLOCK: Record<string, string> = { Normal: 'Lv.3 at 7★', Special: 'Lv.3 at 9★', Ultimate: 'Lv.3 at 11★' };

const rows = (ids: string[]) => ids.map((id) => {
  const app = applications.get(id)!;
  const e = app.effect ? effects.get(app.effect) : undefined;
  return { app, e, fk: e ? familyKey(e) : null };
}).filter((r) => r.app);

// "At a glance": what this unit inflicts, grants, and needs on its target
const inflicts = new Map<string, string>(), grants = new Map<string, string>(), needs = new Set<string>();
for (const s of skills) for (const { app, e, fk } of rows(s.applications)) {
  if (e && fk) {
    const harmful = e.polarity === 'Harmful' || /Enem|Target Hit|Attacker/.test(app.target ?? '');
    (harmful ? inflicts : grants).set(fk.label, fk.key);
  }
  for (const f of app.requires?.families ?? []) needs.add(f);
}
const ownSupplies = [...needs].filter((f) => inflicts.has(f));
const sig = unit.signatureLacrima ? lacrimaById.get(unit.signatureLacrima) : undefined;
const sameIdentity = units.filter((u) => u.identity && u.identity === unit.identity && u.id !== unit.id);
const effectLabel = (e: Effect | undefined) => (e ? baseName(e) : '—');
const debut = unit.debutBanner ? bannerById.get(unit.debutBanner) : undefined;
const debutDates = unitDates(unit, debut);
const rIcon = roleIcon(unit.role);
const bonusPct = unit.rarity ? COLLECTION_BONUS_PCT[unit.rarity] : undefined;
const bonusLevel = bonusPct ? bonusPct * COLLECTION_LEVEL_STEPS : 0;
const bonusAwaken = bonusPct ? bonusPct * COLLECTION_AWAKEN_STEPS : 0;
const normal = skills.find((x) => x.kind === 'Normal');
const nIcon = normal ? skillIcon(unit, normal) : null;
---
<Base title={unit.name} section="characters" description={`${unit.name}: ${unit.attribute} ${unit.role} wizard in FAIRY TAIL Wizard Chronicle — skills, effects and signature lacrima.`}>
  <div class="wrap" data-pagefind-body data-pagefind-meta={`title:${unit.name}`}>
    <span hidden data-pagefind-filter="Type">Wizard</span><span hidden data-pagefind-filter="Attribute">{unit.attribute}</span><span hidden data-pagefind-filter="Role">{unit.role}</span><span hidden data-pagefind-filter="Rarity">{unit.rarity}</span>
    {portraits.has(unit.id) && <span hidden data-pagefind-meta={`image:${url(`portraits/${unit.id}.webp`)}`}></span>}
    <nav class="crumbs" data-pagefind-ignore aria-label="Breadcrumb">
      <a href={url('characters/')}>Wizard Roster</a><span aria-hidden="true">/</span>
      <a href={url(`characters/?attr=${unit.attribute}`)}>{unit.attribute}</a>
    </nav>

    <section class="panel hero">
      <MagicCircle size={520} style="right:-90px;top:-90px" />
      <div class="portrait" style={`--c:${a.color};--t:${a.tint}`}>
        {portraits.has(unit.id)
          ? <img src={url(`portraits/${unit.id}.webp`)} alt={unit.name} width="340" height="340" />
          : <span class="heading ph">{initials(unit.name)}</span>}
        <span class={`ur rarity rarity-${unit.rarity}`}>{unit.rarity}</span>
        {unit.card && <button type="button" class="card-open" data-card-open aria-haspopup="dialog" aria-label={`View ${unit.name} release card`}><span class="hint">View card</span></button>}
      </div>
      {unit.card && (
        <dialog class="card-dialog" data-card-dialog aria-label={`${unit.name} release card`} data-pagefind-ignore>
          <form method="dialog"><button class="close" aria-label="Close">&times;</button></form>
          <img src={url(`cards/${unit.card}`)} alt={`${unit.name} release card`} width="720" height="960" loading="lazy" />
        </dialog>
      )}
      <div class="info">
        <h1>{unit.name}</h1>
        <div class="badges">
          <span class="badge"><Kanji attr={unit.attribute} size={30} /><span style={`color:${a.text};font-weight:600`}>{unit.attribute}</span></span>
          <span class="badge">{rIcon && <img class="ic" src={rIcon} alt="" width="26" height="26" />}Role · {unit.role}</span>
          {skills[0]?.attackRange && <span class="badge">{nIcon && <img class="ic sq" src={nIcon} alt="" width="26" height="26" />}Normal attack · {skills[0].attackRange}</span>}
        </div>
        <div class="glance" data-pagefind-ignore>
          {inflicts.size > 0 && (
            <div><span class="lbl">Inflicts</span><div class="chips">
              {[...inflicts].map(([label, key]) => <a class="tag bad" href={url(`effects/${key}/`)}>{label}</a>)}
            </div></div>
          )}
          {grants.size > 0 && (
            <div><span class="lbl">Grants</span><div class="chips">
              {[...grants].map(([label, key]) => <a class="tag good" href={url(`effects/${key}/`)}>{label}</a>)}
            </div></div>
          )}
          {needs.size > 0 && (
            <div><span class="lbl">Needs on target</span><div class="chips">
              <span class="tag need">{[...needs].join(' or ')}</span>
              {ownSupplies.length > 0 && <span class="own">Applies {ownSupplies.join(', ')} itself</span>}
            </div></div>
          )}
        </div>
      </div>
    </section>

    <div class="cols">
      <div class="skills">
        <div class="section-title"><Pennant /><h2>Skills</h2></div>
        {skills.map((s) => {
          const r = rows(s.applications);
          return (
            <article class="skill">
              <div class="skill-head">
                {skillIcon(unit, s) && <img class="skill-ic" src={skillIcon(unit, s)} alt="" width="40" height="40" />}
                <span class={`kind kind-${s.kind}`} data-pagefind-ignore>{s.kind}</span>
                <h3 id={`skill-${s.kind.toLowerCase()}`}>{s.name ?? s.kind}</h3>
                <span class="muted unlock" data-pagefind-ignore>{UNLOCK[s.kind]}</span>
              </div>
              {s.gameText?.Lv3 && <p class="text">{s.gameText.Lv3}</p>}
              {s.notes && <p class="snote"><span class="nl">Note</span>{s.notes}</p>}
              {r.length > 0 && (
                <div class="table-wrap" data-pagefind-ignore>
                  <table class="fx">
                    <thead><tr><th scope="col">Effect</th><th scope="col">Target</th><th scope="col">Trigger</th><th scope="col">Chance</th><th scope="col">Duration</th><th scope="col">Value</th></tr></thead>
                    <tbody>
                      {r.map(({ app, e, fk }) => (
                        <tr>
                          <td>
                            <span class={`tier tier-${e?.tier ?? 'none'}`}>{e?.tier ?? '—'}</span>{' '}
                            {fk ? <a href={url(`effects/${fk.key}/`)}><strong>{effectLabel(e)}</strong></a> : <strong>{effectLabel(e)}</strong>}
                            {app.requires && <div class="cond">if target has {app.requires.families.join(' or ')}</div>}
                            {app.condition && <div class="cond">{app.condition}</div>}
                          </td>
                          <td>{app.target ?? '—'}</td>
                          <td>{app.trigger?.raw ?? '—'}</td>
                          <td class="num">{app.chance != null ? Math.round(app.chance * 100) + '%' : '—'}</td>
                          <td class="num">{app.durationSeconds != null ? app.durationSeconds + 's' : '—'}</td>
                          <td class="num">{valueText(app, e)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {s.gameText?.Lv1
                ? <details class="levels" data-pagefind-ignore>
                    <summary>Lv.1–2</summary>
                    {['Lv1', 'Lv2'].map((k) => s.gameText[k] && <p class="lv"><span class="lvl">{k.replace('Lv', 'Lv.')}</span><span>{s.gameText[k]}</span></p>)}
                    {s.levelTextSource === WIKI_CREDIT.name && <p class="credit">Lv.1–2: <a href={WIKI_CREDIT.href}>{WIKI_CREDIT.name}</a> (<a href={WIKI_CREDIT.licenseHref}>{WIKI_CREDIT.license}</a>)</p>}
                  </details>
                : null}
            </article>
          );
        })}
      </div>

      <aside class="side">
        {(debut || unit.newForm || unit.availableFrom) && (
          <div class="debut" data-pagefind-ignore>
            {unit.bannerArt && <img class="art" src={url(`banner-art/${unit.bannerArt}`)} alt={`${unit.name} banner art`} width="640" height="240" loading="lazy" />}
            <div class="debut-body">
              {debut && <>
                <span class="lbl">First available</span>
                <a class="heading" href={url(`banners/#${debut.id}`)}>{debut.name}</a>
                {debutDates && <span class="when" title={DATE_NOTE}>{debutDates}</span>}
              </>}
              {!debut && unit.availableFrom && <>
                <span class="lbl">{unit.availableFrom === LAUNCH_DAY ? 'Available from launch' : 'First available'}</span>
                <span class="when-big">{dayText(unit.availableFrom)}</span>
              </>}
              {unit.newForm && <p class="nf"><strong>New Form</strong> · Pickup (paid gems) or MadoFes only</p>}
            </div>
          </div>
        )}
        {(unit.collection || (unit.collectionBonusStat && bonusPct)) && (
          <div class="collbox" data-pagefind-ignore>
            <span class="lbl">In-game collection</span>
            {unit.collection && <span class="heading">{unit.collection}</span>}
            {unit.collectionBonusStat && bonusPct && <>
              <p class="cb-main"><strong>{unit.collectionBonusStat} +{bonusPct}%</strong> for each step reached on the Collection screen</p>
              <ul class="cb-list">
                <li>Level, every 10 levels to Lv.100: up to +{bonusLevel}%</li>
                <li>Awakening, 11 steps: up to +{bonusAwaken}%</li>
              </ul>
              <p class="cb-total">{bonusLevel + bonusAwaken}% {unit.collectionBonusStat} in all</p>
            </>}
          </div>
        )}
        {sig && (
          <div class="lacrima">
            <span class="lbl gold">Signature lacrima</span>
            <a class="heading" href={url(`lacrimas/#${sig.id}`)}>{sig.name}</a>
            {sig.gameText && <p>{sig.gameText}</p>}
            {sig.notes && <p class="signote"><span class="gold">Note · </span>{sig.notes}</p>}
          </div>
        )}
        {sameIdentity.length > 0 && (
          <div class="pinboard">
            <span class="heading">Same identity</span>
            {sameIdentity.map((u, i) => (
              <a class="pin" href={url(`characters/${u.id}/`)} style={`transform:rotate(${i % 2 ? 0.5 : -0.6}deg)`}>{u.name}</a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </div>
</Base>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--muted); margin-bottom: 18px; }
  .hero { display: flex; flex-wrap: wrap; gap: 32px; padding: 30px; }
  .portrait { position: relative; flex: 0 0 300px; aspect-ratio: 1; max-width: 100%; border-radius: 16px; overflow: hidden; background: rgba(var(--t), .14); border: 3px solid var(--brass); box-shadow: 0 0 0 5px var(--panel), 0 0 0 7px var(--c); display: flex; align-items: center; justify-content: center; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  .card-open { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; display: flex; align-items: flex-end; justify-content: flex-end; }
  .card-open .hint { margin: 10px; padding: 5px 12px; border-radius: 999px; background: rgba(43,29,18,.82); color: var(--cream); font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .card-open:hover .hint, .card-open:focus-visible .hint { background: var(--crimson); }
  .card-open:focus-visible { outline: 3px solid var(--crimson); outline-offset: -3px; }
  .card-dialog { padding: 0; border: 3px solid var(--brass); border-radius: 18px; background: var(--timber); max-width: min(92vw, 560px); max-height: 94vh; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,.5); }
  .card-dialog::backdrop { background: rgba(20,12,6,.78); }
  .card-dialog img { display: block; width: auto; height: auto; max-width: 100%; max-height: 94vh; margin: 0 auto; }
  .card-dialog .close { position: absolute; top: 8px; right: 8px; width: 38px; height: 38px; border-radius: 50%; border: 2px solid var(--brass); background: rgba(43,29,18,.85); color: var(--cream); font-size: 24px; line-height: 1; cursor: pointer; }
  .card-dialog .close:hover { background: var(--crimson); }
  .when-big { font-family: var(--serif, Georgia, serif); font-size: 19px; color: var(--ink); }
  .ph { font-size: 64px; color: var(--c); opacity: .6; }
  .ur { position: absolute; left: 12px; top: 12px; padding: 6px 14px; font-size: 14px; }
  .info { position: relative; flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .info h1 { font-size: clamp(30px, 4vw, 44px); line-height: 1.05; }
  .badges { display: flex; flex-wrap: wrap; gap: 10px; }
  .badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; background: #fff; border: 2px solid var(--line); font-size: 14px; }
  .badge:has(.kanji) { padding-left: 4px; }
  .glance { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
  .glance > div { padding: 14px 16px; border-radius: 14px; background: #fff; border: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
  .lbl { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .tag { padding: 4px 10px; border-radius: 999px; font-size: 13px; font-weight: 500; text-decoration: none; }
  .tag.bad { background: #F6DCD7; color: #8A1F25; } .tag.good { background: #DCEBDD; color: #245C33; }
  .tag.need { border: 1px dashed #A88C6A; color: var(--ink); }
  .own { font-size: 12px; font-weight: 600; color: #245C33; }
  .cols { display: flex; flex-wrap: wrap; gap: 28px; align-items: flex-start; }
  .skills { flex: 999 1 640px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .skills .section-title { margin: 36px 0 0; }
  .skill { background: #fff; border: 2px solid var(--line); border-radius: 18px; overflow: hidden; box-shadow: 0 3px 0 var(--brass); }
  .skill-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 20px 22px 0; }
  .skill-head h3 { font-size: 22px; }
  .unlock { margin-left: auto; font-size: 13px; }
  .text { margin: 12px 22px 16px; font-size: 15px; line-height: 1.65; color: #3A2A1F; }
  .snote { margin: -6px 22px 16px; padding: 8px 12px; border-radius: 8px; background: #FBF4E7; border-left: 3px solid var(--brass); font-size: 13px; line-height: 1.55; color: #3A2A1F; }
  .snote .nl { display: block; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--timber); }
  .cond { margin-top: 4px; font-size: 12px; color: var(--muted); }
  .levels { margin: 0; padding: 10px 22px; border-top: 1px solid #EFE3CC; background: #FBF4E7; font-size: 13px; }
  details.levels summary { cursor: pointer; font-weight: 600; color: var(--timber); }
  details.levels .lv { display: flex; gap: 12px; margin: 10px 0 0; font-size: 14px; line-height: 1.6; color: #3A2A1F; }
  details.levels .lvl { flex: none; width: 34px; font: 700 12px var(--mono); color: var(--crimson); padding-top: 3px; }
  .credit { margin: 10px 0 2px; font-size: 12px; color: var(--muted); }
  .side { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 20px; margin-top: 36px; }
  .lacrima { padding: 22px; border-radius: 18px; background: var(--timber); color: #E6D6B8; display: flex; flex-direction: column; gap: 10px; }
  .lacrima a { color: var(--cream); font-size: 19px; }
  .lacrima p { margin: 0; font-size: 14px; line-height: 1.6; }
  .gold { color: #E6C77A; }
  .lacrima p.signote { font-size: 13px; opacity: .9; border-top: 1px solid rgba(230,214,184,.25); padding-top: 10px; }
  .ic { width: 26px; height: 26px; margin: -2px 0; }
  .ic.sq { border-radius: 6px; }
  .badge:has(.ic) { padding-left: 6px; }
  .skill-ic { width: 40px; height: 40px; border-radius: 8px; box-shadow: 0 1px 2px rgba(40,10,6,.35); }
  .debut { border-radius: 18px; overflow: hidden; background: #fff; border: 2px solid var(--line); box-shadow: 0 3px 0 var(--brass); }
  .debut .art { width: 100%; height: auto; aspect-ratio: 640 / 240; object-fit: cover; border-bottom: 2px solid var(--brass); }
  .debut-body { padding: 16px 20px 18px; display: flex; flex-direction: column; gap: 6px; }
  .collbox { border-radius: 18px; background: #fff; border: 2px solid var(--line); box-shadow: 0 3px 0 var(--brass); padding: 16px 20px 18px; display: flex; flex-direction: column; gap: 6px; }
  .collbox .heading { font-size: 19px; color: var(--ink); }
  .collbox p, .collbox ul { margin: 0; font-size: 14px; line-height: 1.5; color: var(--ink); }
  .collbox .cb-main { margin-top: 6px; }
  .collbox .cb-list { padding-left: 18px; color: var(--muted); }
  .collbox .cb-total { font-weight: 700; }
  .debut-body .heading { font-size: 19px; color: var(--ink); }
  .debut-body .heading:hover { color: var(--crimson); }
  .when { font: 500 13px var(--mono); color: var(--muted); cursor: help; }
  .nf { margin: 6px 0 0; font-size: 13px; line-height: 1.55; color: #3A2A1F; }
  .pinboard { padding: 22px; border-radius: 18px; background: var(--ember); border: 3px solid var(--brass); display: flex; flex-direction: column; gap: 10px; }
  .pinboard .heading { color: #FFF3E0; font-size: 18px; }
  .pin { padding: 10px 12px; border-radius: 6px; background: #FFFBF2; color: var(--ink); font-size: 14px; box-shadow: 0 2px 0 rgba(40,10,6,.4); }
  @media (max-width: 600px) { .hero { padding: 20px; } .portrait { flex-basis: 100%; } }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-card-dialog]');
  const opener = document.querySelector<HTMLElement>('[data-card-open]');
  if (dlg && opener) {
    opener.addEventListener('click', () => dlg.showModal());
    // a click on the dark backdrop (the dialog element itself, outside the image) closes it
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>
