---
import { ATTR, type Attribute } from '../lib/data';
interface Props { attr: Attribute; size?: number; }
const { attr, size = 30 } = Astro.props;
const a = ATTR[attr];
---
<span class="kanji" style={`width:${size}px;height:${size}px;background:${a.color};font-size:${Math.round(size * 0.5)}px`} title={attr} aria-label={attr} role="img">{a.kanji}</span>
