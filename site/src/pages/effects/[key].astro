---
import Info from '../../components/Info.astro';
import Base from '../../layouts/Base.astro';
import MagicCircle from '../../components/MagicCircle.astro';
import Kanji from '../../components/Kanji.astro';
import {
  buildFinderIndex, buildCounterIndex, familyBlurb, families, raritiesIn, effects, WIKI_CREDIT, ATTR, ATTR_ORDER, ROLES, KIND_ORDER, TIER_ORDER, url, portraits, initials, tierRank,
  TARGET_GROUPS, targetGroup, needNote,
  type FamilyMeta, type Match, type LacrimaMatch, type CompanionMatch, type Unit, type Skill, type Application,
} from '../../lib/data';

export function getStaticPaths() {
  const idx = buildFinderIndex(true);
  return [...idx.meta.values()].map((m) => ({
    params: { key: m.key },
    props: { m, applies: idx.applies.get(m.key) ?? [], lac: idx.fromLacrimas.get(m.key) ?? [],
      companions: idx.fromCompanions.get(m.key) ?? [], needs: idx.needs.get(m.key) ?? [] },
  }));
}
const counterIdx = buildCounterIndex();
const { m, applies, lac, companions, needs } = Astro.props as {
  m: FamilyMeta; applies: Match[]; lac: LacrimaMatch[]; companions: CompanionMatch[];
  needs: { unit: Unit; skill: Skill; app: Application }[];
};

// Group matches per unit, strongest tier first
const byUnit = new Map<string, { unit: Unit; rows: Match[] }>();
for (const x of applies) (byUnit.get(x.unit.id) ?? byUnit.set(x.unit.id, { unit: x.unit, rows: [] }).get(x.unit.id)!).rows.push(x);
const cards = [...byUnit.values()]
  .map((c) => ({ ...c, rows: c.rows.sort((a, b) => KIND_ORDER.indexOf(a.skill.kind) - KIND_ORDER.indexOf(b.skill.kind)) }))
  .sort((a, b) => Math.min(...a.rows.map((r) => tierRank(r.effect.tier))) - Math.min(...b.rows.map((r) => tierRank(r.effect.tier))) || a.unit.name.localeCompare(b.unit.name));
const needUnits = [...new Map(needs.map((n) => [n.unit.id + n.skill.kind, n])).values()];
const byCompanion = new Map<string, CompanionMatch[]>();
for (const x of companions) (byCompanion.get(x.companion.id) ?? byCompanion.set(x.companion.id, []).get(x.companion.id)!).push(x);

// Tier ladder from the effect definitions themselves
const inFamily = (e: (typeof ladder)[number]) => e.family === m.family && (!m.dir || (e.direction ?? (/(Increase|Up)\b/.test(e.name) ? 'Up' : 'Down')) === m.dir);
const ladder = [...effects.values()]
  .filter((e) => e.family === m.family && (!m.dir || (e.direction ?? (/(Increase|Up)\b/.test(e.name) ? 'Up' : 'Down')) === m.dir) && e.tier && TIER_ORDER.includes(e.tier))
  .sort((a, b) => tierRank(a.tier) - tierRank(b.tier));
// Effects with no tiers (Critical Shield, Bind, Taunt …) have no ladder; show what each one does instead
const plain = ladder.length > 0 ? [] : [...effects.values()].filter((e) => inFamily(e) && !e.tier && e.gameText);
const tiersPresent = [...new Set(applies.map((x) => x.effect.tier).filter(Boolean))] as string[];
const sample = ladder[0];
// Family facts: the Definition (or a generated "Modifies X" for stat families), then Affected Stats when a Definition leads
const famRec = families.get(m.family);
const blurbText = familyBlurb(m.family);
// don't say it twice when an Effect row below already carries the very same sentence (Remove All Buffs / Debuffs)
const blurb = blurbText && !plain.some((e) => e.gameText === blurbText) ? blurbText : null;
const showStats = !!(famRec?.definition && famRec.affectedStats.length);
const raritiesPresent = raritiesIn(cards.map((c) => c.unit));
const attrsPresent = ATTR_ORDER.filter((x) => cards.some((c) => c.unit.attribute === x));
const rolesPresent = ROLES.filter((x) => cards.some((c) => c.unit.role === x));
// Targets are grouped for filtering (TARGET_GROUPS and targetGroup live in lib/data.ts, shared with the team page); each row still shows its exact wording
const targetsPresent = TARGET_GROUPS.filter((g) => cards.some((c) => c.rows.some((r) => targetGroup(r.app.target) === g)));
// Reliability, best first: 0 no condition and no chance; 1 needs a status on the enemy; 2 a chance to proc; 3 any other condition
const reliability = (a: Application) => (a.condition ? 3 : a.chance != null ? 2 : a.requires ? 1 : 0);
const kindsPresent = new Set(cards.flatMap((c) => c.rows.map((r) => r.skill.kind)));
const showSkillFilter = kindsPresent.has('Ultimate') && kindsPresent.size > 1;

const facts = (a: Application) => [a.target, a.trigger?.everySeconds ? `every ${a.trigger.everySeconds} sec` : null, a.durationSeconds != null ? `${a.durationSeconds} sec` : null, a.chance != null ? `${Math.round(a.chance * 100)}%` : null].filter(Boolean).join(' · ');
// Highlight "[Tier] Name" mentions of this effect in game text
const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const fam = m.family.replace(/^Critical /, 'Crit(?:ical)? ');
const rx = new RegExp(`(\\[(?:Top|High|Mid|Low)\\]\\s*(?:${fam}|${esc(m.family)})[^,.\\]]*)`, 'gi');
const segs = (t: string) => t.split(rx).map((s, i) => ({ s, hit: i % 2 === 1 }));
---
<Base title={m.label} section="effects" description={`Wizards, lacrimas and companions in FAIRY TAIL Wizard Chronicle that apply ${m.label}.`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={url('effects/')}>Effect Finder</a></nav>

    <section class="banner" style={`--c:${m.color}`}>
      <MagicCircle size={460} color="#F3D27A" style="right:-60px;top:50%;transform:translateY(-50%);opacity:.28" />
      <div class="banner-body">
        <span class="medal"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#FFF3E0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={m.icon} /></svg></span>
        <div class="what">
          <h1>{m.label} <Info><p>Values and tiers are Lv.3. Open a skill’s Lv.1–2 for earlier values.</p></Info></h1>
          {sample && <span class="sub">{[sample.polarity, sample.mechanic].filter(Boolean).join(' · ')}</span>}
          {blurb && <span class="sub">{blurb}</span>}
          {showStats && <span class="sub">Affects {famRec!.affectedStats.join(', ')}</span>}
          <div class="counts">
            <span><strong id="count-w">{cards.length}</strong> wizards apply it</span>
            {lac.length > 0 && <span><strong>{new Set(lac.map((l) => l.lacrima.id)).size}</strong> lacrimas</span>}
            {byCompanion.size > 0 && <a href="#companions"><strong>{byCompanion.size}</strong> {byCompanion.size === 1 ? 'companion' : 'companions'}</a>}
            {needUnits.length > 0 && <a href="#needs"><strong>{new Set(needUnits.map((n) => n.unit.id)).size}</strong> need it on the target</a>}
          </div>
        </div>
        {ladder.length > 0 && (
          <div class="ladder" role="list" aria-label={`${m.label} by tier`}>
            {ladder.map((e) => (
              <div role="listitem" class={`rung rung-${e.tier}`}>
                <span class="t">{e.tier}</span>
                <span class="v">{e.gameText ?? (e.value ? `${e.value.amount}` : '—')}</span>
              </div>
            ))}
          </div>
        )}
        {plain.length > 0 && (
          <div class="ladder" role="list" aria-label={`What ${m.label} does`}>
            {plain.map((e) => (
              <div role="listitem" class="rung rung-plain">
                <span class="t">{plain.length > 1 ? e.name : 'Effect'}</span>
                <span class="v">{e.gameText}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    {(counterIdx.counteredBy.has(m.key) || counterIdx.counters.has(m.key)) && (
      <section class="counters" aria-label="Counters">
        {counterIdx.counteredBy.has(m.key) && (
          <div class="crow"><span class="clbl">Countered by</span>
            <span class="clist">{counterIdx.counteredBy.get(m.key)!.map((c) => <a class="chip" href={url(`effects/${c.key}/`)}>{c.label}</a>)}</span></div>
        )}
        {counterIdx.counters.has(m.key) && (
          <div class="crow"><span class="clbl">Counters</span>
            <span class="clist">{counterIdx.counters.get(m.key)!.map((c) => <a class="chip" href={url(`effects/${c.key}/`)}>{c.label}</a>)}</span></div>
        )}
      </section>
    )}

    <div>
    <div class="filters" aria-label="Filter wizards">
      {tiersPresent.length > 1 && (
        <div class="row" role="group" aria-label="Tier">
          <span class="lbl">Tier</span>
          <button type="button" class="pill" data-filter="tier" data-value="" aria-pressed="true">All</button>
          {TIER_ORDER.filter((t) => tiersPresent.includes(t)).map((t) => <button type="button" class="pill" data-filter="tier" data-value={t} aria-pressed="false">{t}</button>)}
        </div>
      )}
      {raritiesPresent.length > 1 && (
        <div class="row" role="group" aria-label="Rarity">
          <span class="lbl">Rarity</span>
          <button type="button" class="pill" data-filter="rarity" data-value="" aria-pressed="true">All</button>
          {raritiesPresent.map((x) => <button type="button" class="pill" data-filter="rarity" data-value={x} aria-pressed="false">{x}</button>)}
        </div>
      )}
      {attrsPresent.length > 1 && (
        <div class="row" role="group" aria-label="Attribute">
          <span class="lbl">Attribute</span>
          <button type="button" class="pill" data-filter="attr" data-value="" aria-pressed="true">All</button>
          {attrsPresent.map((x) => <button type="button" class="pill" data-filter="attr" data-value={x} aria-pressed="false"><Kanji attr={x} size={22} />{x}</button>)}
        </div>
      )}
      {rolesPresent.length > 1 && (
        <div class="row" role="group" aria-label="Role">
          <span class="lbl">Role</span>
          <button type="button" class="pill" data-filter="role" data-value="" aria-pressed="true">All</button>
          {rolesPresent.map((x) => <button type="button" class="pill" data-filter="role" data-value={x} aria-pressed="false">{x}</button>)}
        </div>
      )}
      {targetsPresent.length > 1 && (
        <div class="row" role="group" aria-label="Target">
          <span class="lbl">Target</span>
          <button type="button" class="pill" data-filter="target" data-value="" aria-pressed="true">All</button>
          {targetsPresent.map((t) => <button type="button" class="pill" data-filter="target" data-value={t} aria-pressed="false">{t}</button>)}
        </div>
      )}
      {showSkillFilter && (
        <div class="row" role="group" aria-label="Skill">
          <span class="lbl">Skill</span>
          <button type="button" class="pill" data-filter="skills" data-value="" aria-pressed="true">All</button>
          <button type="button" class="pill" data-filter="skills" data-value="noult" aria-pressed="false">No Ultimate</button>
          <button type="button" class="pill" data-filter="skills" data-value="ult" aria-pressed="false">Ultimate only</button>
        </div>
      )}
      <div class="row" role="group" aria-label="Sort">
        <span class="lbl">Sort</span>
        <button type="button" class="pill" data-filter="sort" data-value="" aria-pressed="true">Tier</button>
        <button type="button" class="pill" data-filter="sort" data-value="fastest" aria-pressed="false">Fastest</button>
        <button type="button" class="pill" data-filter="sort" data-value="reliable" aria-pressed="false">Reliable</button>
      </div>
      <p class="status" id="status" hidden><span id="shown">{cards.length}</span> of {cards.length} wizards<span id="active"> · <button type="button" class="clear">Clear filters</button></span></p>
    </div>

    <div class="results">
      {cards.map(({ unit, rows }) => {
        const a = ATTR[unit.attribute];
        return (
          <article class="card" data-rarity={unit.rarity} data-attr={unit.attribute} data-role={unit.role} data-tiers={rows.map((r) => r.effect.tier ?? '').join(' ')} style={`--c:${a.color};--t:${a.tint}`}>
            <div class="card-head">
              <span class="av">
                {portraits.has(unit.id) ? <img src={url(`portraits/${unit.id}.webp`)} alt="" loading="lazy" width="60" height="60" /> : <span class="heading">{initials(unit.name)}</span>}
              </span>
              <div class="who">
                <a class="heading" href={url(`characters/${unit.id}/`)}>{unit.name}</a>
                <span class="meta"><Kanji attr={unit.attribute} size={22} />{unit.attribute} · {unit.role}</span>
              </div>
              {rows.length > 1 && <span class="n">{rows.length} skills</span>}
            </div>
            {rows.map(({ skill, app, effect }) => (
              <div class="hit" data-tier={effect.tier ?? ''} data-kind={skill.kind} data-target={targetGroup(app.target)} data-interval={app.trigger?.everySeconds ?? ''} data-chance={app.chance ?? ''} data-rel={reliability(app)}>
                <div class="hit-head"><span class={`kind kind-${skill.kind}`}>{skill.kind}</span><span class="heading sk">{skill.name ?? skill.kind}</span></div>
                <div class="match"><span class={`tier tier-${effect.tier ?? 'none'}`}>{effect.tier ?? '—'}</span><strong>{m.label}</strong><span>{facts(app)}</span></div>
                {needNote(app) && <p class="need">{needNote(app)}</p>}
                {skill.gameText?.Lv3 && (
                  <p class="lv"><span class="lvl">Lv.3</span><span>{segs(skill.gameText.Lv3).map((x) => x.hit ? <mark class="mark">{x.s}</mark> : x.s)}</span></p>
                )}
                {skill.gameText?.Lv1
                  ? <details><summary>Lv.1–2</summary>{['Lv1', 'Lv2'].map((k) => skill.gameText[k] && <p class="lv"><span class="lvl">{k.replace('Lv', 'Lv.')}</span><span>{skill.gameText[k]}</span></p>)}{skill.levelTextSource === WIKI_CREDIT.name && <p class="credit">Lv.1–2: <a href={WIKI_CREDIT.href}>{WIKI_CREDIT.name}</a> (<a href={WIKI_CREDIT.licenseHref}>{WIKI_CREDIT.license}</a>)</p>}</details>
                  : null}
              </div>
            ))}
          </article>
        );
      })}
    </div>

    <p id="none" class="muted" hidden>No wizards match. <button type="button" class="clear">Clear filters</button></p>

    {byCompanion.size > 0 && (
      <section id="companions">
        <div class="section-title"><h2>Companions</h2></div>
        <div class="lac-list">
          {[...byCompanion.values()].map((rows) => (
            <div class="companion-match">
              <a class="heading" href={url(`companions/${rows[0].companion.id}/`)}>{rows[0].companion.name}</a>
              {rows.map(({ app, effect }) => (
                <div class="match">
                  <span class={`tier tier-${effect.tier ?? 'none'}`}>{effect.tier ?? '—'}</span>
                  <strong>{app.type ?? m.label}</strong>
                  <span>{[app.trigger?.raw, app.target].filter(Boolean).join(' · ')}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}

    {lac.length > 0 && (
      <section id="lacrimas">
        <div class="section-title"><h2>Lacrimas that apply it</h2></div>
        <p class="lac-more"><a href={url(`lacrimas/?effect=${encodeURIComponent(m.label)}`)}>Filter these by trigger and target →</a></p>
        <div class="lac-list">
          {[...new Map(lac.map((l) => [l.lacrima.id, l])).values()].map(({ lacrima, effect, app }) => (
            <div class="lac" data-tier={effect.tier ?? ''}>
              <a class="heading" href={url(`lacrimas/#${lacrima.id}`)}>{lacrima.name}</a>
              <div class="match"><span class={`tier tier-${effect.tier ?? 'none'}`}>{effect.tier ?? '—'}</span><strong>{m.label}</strong><span>{[app.trigger?.raw, facts(app)].filter(Boolean).join(' · ')}</span></div>
            </div>
          ))}
        </div>
      </section>
    )}

    {needUnits.length > 0 && (
      <section id="needs">
        <div class="section-title"><h2>Needs {m.label} on the target</h2></div>
        <div class="table-wrap needs">
          <table class="fx">
            <thead><tr><th scope="col">Wizard</th><th scope="col">Skill</th><th scope="col">Unlocks</th><th scope="col">Needs any of</th></tr></thead>
            <tbody>
              {needUnits.map(({ unit, skill, app }) => {
                const e = app.effect ? effects.get(app.effect) : undefined;
                return (
                  <tr data-rarity={unit.rarity}>
                    <td><a href={url(`characters/${unit.id}/`)}><strong>{unit.name}</strong></a></td>
                    <td><span class={`kind kind-${skill.kind}`}>{skill.kind}</span></td>
                    <td>{e?.name ?? '—'}</td>
                    <td>{app.requires?.families.join(', ')}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </div>
  </div>
</Base>

<script>
  // Tier narrows skills and lacrimas; attribute and role narrow wizards. All three combine.
  const pills = [...document.querySelectorAll<HTMLButtonElement>('.filters .pill')];
  const params = new URLSearchParams(location.search);
  const known = [...document.querySelectorAll<HTMLButtonElement>('.filters .pill[data-filter=rarity]')].map((b) => b.dataset.value);
  const oneOf = (k: string, ok: string[]) => (ok.includes(params.get(k) ?? '') ? params.get(k) : null);
  const state: Record<string, string | null> = { rarity: known.includes(params.get('rarity') ?? '') ? params.get('rarity') : null, tier: params.get('tier'), attr: params.get('attr'), role: params.get('role'), skills: oneOf('skills', ['noult', 'ult']), target: oneOf('target', [...document.querySelectorAll<HTMLButtonElement>('.filters .pill[data-filter=target]')].map((b) => b.dataset.value ?? '')), sort: oneOf('sort', ['fastest', 'reliable']) };
  const results = document.querySelector('.results');
  const original = [...document.querySelectorAll<HTMLElement>('.card')];
  const num = (v?: string) => (v === undefined || v === '' ? null : Number(v));
  // Sort key from the skills still showing: fastest = shortest repeat time (no repeat time sorts last); reliable = unconditional first, then status-ailment conditions, then chance procs (higher chance first), then other conditions
  function key(card: HTMLElement) {
    const hits = [...card.querySelectorAll<HTMLElement>('.hit')].filter((h) => !h.hidden);
    if (state.sort === 'fastest') { const v = hits.map((h) => num(h.dataset.interval)).filter((x): x is number => x !== null); return v.length ? Math.min(...v) : Infinity; }
    if (state.sort === 'reliable') return Math.min(...hits.map((h) => Number(h.dataset.rel) + (1 - (num(h.dataset.chance) ?? 1)) / 10));
    return 0;
  }
  function apply() {
    let n = 0;
    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      let any = false;
      card.querySelectorAll<HTMLElement>('.hit').forEach((h) => { const ok = (!state.tier || h.dataset.tier === state.tier) && (!state.skills || (state.skills === 'ult') === (h.dataset.kind === 'Ultimate')) && (!state.target || h.dataset.target === state.target); h.hidden = !ok; any ||= ok; });
      const ok = any && (!state.rarity || card.dataset.rarity === state.rarity) && (!state.attr || card.dataset.attr === state.attr) && (!state.role || card.dataset.role === state.role);
      card.hidden = !ok; if (ok) n++;
    });
    document.querySelectorAll<HTMLElement>('.needs tbody tr').forEach((r) => { r.hidden = !!state.rarity && r.dataset.rarity !== state.rarity; });
    document.querySelectorAll<HTMLElement>('.lac').forEach((l) => { l.hidden = !!state.tier && l.dataset.tier !== state.tier; });
    for (const p of pills) p.setAttribute('aria-pressed', String((state[p.dataset.filter!] ?? '') === p.dataset.value));
    const keyed = new Map(original.map((c) => [c, key(c)]));
    original.slice().sort((a, b) => { const x = keyed.get(a)!, y = keyed.get(b)!; return x < y ? -1 : x > y ? 1 : original.indexOf(a) - original.indexOf(b); }).forEach((c) => results?.appendChild(c));
    document.getElementById('shown')!.textContent = String(n);
    document.getElementById('count-w')!.textContent = String(n);
    document.getElementById('none')!.hidden = n > 0 || !document.querySelector('.card');
    const active = [state.rarity, state.tier && state.tier + ' tier', state.attr, state.role, state.target, state.skills && (state.skills === 'ult' ? 'Ultimate only' : 'No Ultimate')].filter(Boolean);
    document.getElementById('status')!.hidden = active.length === 0;
    document.getElementById('active')!.hidden = n === 0;
    const p = new URLSearchParams();
    for (const [k, v] of Object.entries(state)) if (v) p.set(k, v);
    const qs = p.toString();
    history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
  }
  for (const p of pills) p.addEventListener('click', () => {
    state[p.dataset.filter!] = p.dataset.value || null; apply();
  });
  document.querySelectorAll('.clear').forEach((b) => b.addEventListener('click', () => { state.tier = state.attr = state.role = state.rarity = state.skills = state.target = null; apply(); }));
  apply();
</script>

<style>
  .crumbs { display: flex; gap: 8px; font-size: 14px; color: var(--muted); margin-bottom: 18px; }
  .banner { position: relative; overflow: hidden; border-radius: 24px; background: color-mix(in srgb, var(--c) 78%, #2a0f08); color: #FFF3E0; border: 3px solid var(--brass); box-shadow: 0 4px 0 rgba(40,10,6,.5), 0 14px 30px rgba(74,47,30,.25); }
  .banner-body { position: relative; padding: 28px 32px; display: flex; flex-wrap: wrap; gap: 28px; align-items: center; }
  .medal { flex: none; width: 96px; height: 96px; border-radius: 50%; background: rgba(0,0,0,.25); border: 4px solid var(--brass); display: flex; align-items: center; justify-content: center; }
  .what { flex: 1 1 280px; display: flex; flex-direction: column; gap: 6px; }
  .what h1 { font-size: clamp(36px, 5vw, 54px); line-height: 1; }
  .sub { font-size: 15px; color: #F6DFC8; }
  .counts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .counts > * { padding: 6px 12px; border-radius: 999px; background: rgba(255,243,224,.14); border: 1px solid rgba(243,210,122,.5); font-size: 13px; color: #FFF3E0; }
  .counts strong { font-family: var(--heading); font-size: 16px; }
  .ladder { flex: 1 1 380px; display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; }
  .rung { padding: 12px; border-radius: 14px; background: #FBEBD5; color: var(--ink); display: flex; flex-direction: column; gap: 4px; }
  .rung-plain { background: #FFF3E0; border: 2px solid var(--brass); }
  .rung-Top { background: #FFF3E0; border: 2px solid var(--brass); }
  .rung .t { font: 700 12px var(--mono); text-transform: uppercase; color: var(--ember); }
  .rung .v { font-size: 13px; line-height: 1.35; }
  .lac-more { margin: -4px 0 12px; font-size: 14px; font-weight: 600; }
  .counters { display: flex; flex-direction: column; gap: 8px; margin: 18px 0 0; }
  .crow { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 12px; }
  .clbl { width: 92px; flex: none; font-size: 13px; font-weight: 700; color: var(--timber); }
  .clist { display: flex; flex-wrap: wrap; gap: 6px; }
  .filters { display: flex; flex-direction: column; gap: 10px; margin: 22px 0 0; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
