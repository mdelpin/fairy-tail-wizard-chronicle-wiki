---
import Base from '../../layouts/Base.astro';
import MagicCircle from '../../components/MagicCircle.astro';
import Kanji from '../../components/Kanji.astro';
import {
  buildFinderIndex, effects, ATTR, KIND_ORDER, TIER_ORDER, url, portraits, initials, tierRank,
  type FamilyMeta, type Match, type LacrimaMatch, type Unit, type Skill, type Application,
} from '../../lib/data';

export function getStaticPaths() {
  const idx = buildFinderIndex();
  return [...idx.meta.values()].map((m) => ({
    params: { key: m.key },
    props: { m, applies: idx.applies.get(m.key) ?? [], lac: idx.fromLacrimas.get(m.key) ?? [], needs: idx.needs.get(m.key) ?? [] },
  }));
}
const { m, applies, lac, needs } = Astro.props as {
  m: FamilyMeta; applies: Match[]; lac: LacrimaMatch[]; needs: { unit: Unit; skill: Skill; app: Application }[];
};

// Group matches per unit, strongest tier first
const byUnit = new Map<string, { unit: Unit; rows: Match[] }>();
for (const x of applies) (byUnit.get(x.unit.id) ?? byUnit.set(x.unit.id, { unit: x.unit, rows: [] }).get(x.unit.id)!).rows.push(x);
const cards = [...byUnit.values()]
  .map((c) => ({ ...c, rows: c.rows.sort((a, b) => KIND_ORDER.indexOf(a.skill.kind) - KIND_ORDER.indexOf(b.skill.kind)) }))
  .sort((a, b) => Math.min(...a.rows.map((r) => tierRank(r.effect.tier))) - Math.min(...b.rows.map((r) => tierRank(r.effect.tier))) || a.unit.name.localeCompare(b.unit.name));
const needUnits = [...new Map(needs.map((n) => [n.unit.id + n.skill.kind, n])).values()];

// Tier ladder from the effect definitions themselves
const ladder = [...effects.values()]
  .filter((e) => e.family === m.family && (!m.dir || (e.direction ?? (/(Increase|Up)\b/.test(e.name) ? 'Up' : 'Down')) === m.dir) && e.tier && TIER_ORDER.includes(e.tier))
  .sort((a, b) => tierRank(a.tier) - tierRank(b.tier));
const tiersPresent = [...new Set(applies.map((x) => x.effect.tier).filter(Boolean))] as string[];
const sample = ladder[0];

const facts = (a: Application) => [a.target, a.durationSeconds != null ? `${a.durationSeconds} sec` : null, a.chance != null ? `${Math.round(a.chance * 100)}%` : null].filter(Boolean).join(' · ');
// Highlight "[Tier] Name" mentions of this effect in game text
const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const fam = m.family.replace(/^Critical /, 'Crit(?:ical)? ');
const rx = new RegExp(`(\\[(?:Top|High|Mid|Low)\\]\\s*(?:${fam}|${esc(m.family)})[^,.\\]]*)`, 'gi');
const segs = (t: string) => t.split(rx).map((s, i) => ({ s, hit: i % 2 === 1 }));
---
<Base title={m.label} section="effects" description={`Every wizard and lacrima in FAIRY TAIL Wizard Chronicle that applies ${m.label}.`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={url('effects/')}>Effect Finder</a><span aria-hidden="true">/</span><span>{m.label}</span></nav>

    <section class="banner" style={`--c:${m.color}`}>
      <MagicCircle size={460} color="#F3D27A" style="right:-60px;top:50%;transform:translateY(-50%);opacity:.28" />
      <div class="banner-body">
        <span class="medal"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#FFF3E0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={m.icon} /></svg></span>
        <div class="what">
          <span class="eyebrow">Effect Finder</span>
          <h1>{m.label}</h1>
          {sample && <span class="sub">{[sample.polarity, sample.mechanic].filter(Boolean).join(' · ')}</span>}
          <div class="counts">
            <span><strong>{cards.length}</strong> wizards apply it</span>
            {lac.length > 0 && <span><strong>{new Set(lac.map((l) => l.lacrima.id)).size}</strong> lacrimas</span>}
            {needUnits.length > 0 && <a href="#needs"><strong>{new Set(needUnits.map((n) => n.unit.id)).size}</strong> need it on the target</a>}
          </div>
        </div>
        {ladder.length > 0 && (
          <div class="ladder" role="list" aria-label={`${m.label} by tier`}>
            {ladder.map((e) => (
              <div role="listitem" class={`rung rung-${e.tier}`}>
                <span class="t">{e.tier}</span>
                <span class="v">{e.gameText ?? (e.value ? `${e.value.amount}` : '—')}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    {tiersPresent.length > 1 && (
      <div class="tierbar" role="group" aria-label="Filter by tier">
        <span class="lbl">Tier</span>
        <button type="button" class="pill" data-tier="" aria-pressed="true">All</button>
        {TIER_ORDER.filter((t) => tiersPresent.includes(t)).map((t) => <button type="button" class="pill" data-tier={t} aria-pressed="false">{t}</button>)}
      </div>
    )}
    <p class="hint">Matches use Lv.3 values. Earlier levels are shown where they’ve been recorded.</p>

    <div class="results">
      {cards.map(({ unit, rows }) => {
        const a = ATTR[unit.attribute];
        return (
          <article class="card" data-tiers={rows.map((r) => r.effect.tier ?? '').join(' ')} style={`--c:${a.color};--t:${a.tint}`}>
            <div class="card-head">
              <span class="av">
                {portraits.has(unit.id) ? <img src={url(`portraits/${unit.id}.webp`)} alt="" loading="lazy" width="60" height="60" /> : <span class="heading">{initials(unit.name)}</span>}
              </span>
              <div class="who">
                <a class="heading" href={url(`characters/${unit.id}/`)}>{unit.name}</a>
                <span class="meta"><Kanji attr={unit.attribute} size={22} />{unit.attribute} · {unit.role}</span>
              </div>
              {rows.length > 1 && <span class="n">{rows.length} skills</span>}
            </div>
            {rows.map(({ skill, app, effect }) => (
              <div class="hit" data-tier={effect.tier ?? ''}>
                <div class="hit-head"><span class={`kind kind-${skill.kind}`}>{skill.kind}</span><span class="heading sk">{skill.name ?? skill.kind}</span></div>
                <div class="match"><span class={`tier tier-${effect.tier ?? 'none'}`}>{effect.tier ?? '—'}</span><strong>{m.label}</strong><span>{facts(app)}</span></div>
                {skill.gameText?.Lv3 && (
                  <p class="lv"><span class="lvl">Lv.3</span><span>{segs(skill.gameText.Lv3).map((x) => x.hit ? <mark class="mark">{x.s}</mark> : x.s)}</span></p>
                )}
                {skill.gameText?.Lv1
                  ? <details><summary>Show Lv.1–2</summary>{['Lv1', 'Lv2'].map((k) => skill.gameText[k] && <p class="lv"><span class="lvl">{k.replace('Lv', 'Lv.')}</span><span>{skill.gameText[k]}</span></p>)}</details>
                  : <p class="nolv">Lv.1 and Lv.2 not recorded yet.</p>}
              </div>
            ))}
          </article>
        );
      })}
    </div>

    {lac.length > 0 && (
      <section>
        <div class="section-title"><h2>Lacrimas that apply it</h2></div>
        <div class="lac-list">
          {[...new Map(lac.map((l) => [l.lacrima.id, l])).values()].map(({ lacrima, effect, app }) => (
            <div class="lac" data-tier={effect.tier ?? ''}>
              <span class={`tier tier-${effect.tier ?? 'none'}`}>{effect.tier ?? '—'}</span>
              <a class="heading" href={url(`lacrimas/#${lacrima.id}`)}>{lacrima.name}</a>
              <span class="muted">{[app.trigger?.raw, facts(app)].filter(Boolean).join(' · ')}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {needUnits.length > 0 && (
      <section id="needs">
        <div class="section-title"><h2>Needs {m.label} on the target</h2><p>These skills only trigger extra effects when the target already has it.</p></div>
        <div class="table-wrap needs">
          <table class="fx">
            <thead><tr><th scope="col">Wizard</th><th scope="col">Skill</th><th scope="col">Unlocks</th><th scope="col">Needs any of</th></tr></thead>
            <tbody>
              {needUnits.map(({ unit, skill, app }) => {
                const e = app.effect ? effects.get(app.effect) : undefined;
                return (
                  <tr>
                    <td><a href={url(`characters/${unit.id}/`)}><strong>{unit.name}</strong></a></td>
                    <td><span class={`kind kind-${skill.kind}`}>{skill.kind}</span></td>
                    <td>{e?.name ?? '—'}</td>
                    <td>{app.requires?.families.join(', ')}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  const pills = [...document.querySelectorAll<HTMLButtonElement>('.tierbar .pill')];
  pills.forEach((p) => p.addEventListener('click', () => {
    const t = p.dataset.tier!;
    pills.forEach((q) => q.setAttribute('aria-pressed', String(q === p)));
    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      let any = false;
      card.querySelectorAll<HTMLElement>('.hit').forEach((h) => { const ok = !t || h.dataset.tier === t; h.hidden = !ok; any ||= ok; });
      card.hidden = !any;
    });
    document.querySelectorAll<HTMLElement>('.lac').forEach((l) => { l.hidden = !!t && l.dataset.tier !== t; });
  }));
</script>

<style>
  .crumbs { display: flex; gap: 8px; font-size: 14px; color: var(--muted); margin-bottom: 18px; }
  .banner { position: relative; overflow: hidden; border-radius: 24px; background: color-mix(in srgb, var(--c) 78%, #2a0f08); color: #FFF3E0; border: 3px solid var(--brass); box-shadow: 0 4px 0 rgba(40,10,6,.5), 0 14px 30px rgba(74,47,30,.25); }
  .banner-body { position: relative; padding: 28px 32px; display: flex; flex-wrap: wrap; gap: 28px; align-items: center; }
  .medal { flex: none; width: 96px; height: 96px; border-radius: 50%; background: rgba(0,0,0,.25); border: 4px solid var(--brass); display: flex; align-items: center; justify-content: center; }
  .what { flex: 1 1 280px; display: flex; flex-direction: column; gap: 6px; }
  .eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #F3D27A; }
  .what h1 { font-size: clamp(36px, 5vw, 54px); line-height: 1; }
  .sub { font-size: 15px; color: #F6DFC8; }
  .counts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .counts > * { padding: 6px 12px; border-radius: 999px; background: rgba(255,243,224,.14); border: 1px solid rgba(243,210,122,.5); font-size: 13px; color: #FFF3E0; }
  .counts strong { font-family: var(--heading); font-size: 16px; }
  .ladder { flex: 1 1 380px; display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; }
  .rung { padding: 12px; border-radius: 14px; background: #FBEBD5; color: var(--ink); display: flex; flex-direction: column; gap: 4px; }
  .rung-Top { background: #FFF3E0; border: 2px solid var(--brass); }
  .rung .t { font: 700 12px var(--mono); text-transform: uppercase; color: var(--ember); }
  .rung .v { font-size: 13px; line-height: 1.35; }
  .tierbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 22px 0 0; }
  .lbl { font-size: 13px; font-weight: 700; color: var(--timber); margin-right: 4px; }
  .pill { min-height: 38px; padding: 0 16px; border-radius: 999px; border: 2px solid var(--line); background: #fff; color: var(--ink); font: 600 13px var(--body); cursor: pointer; }
  .pill[aria-pressed='true'] { background: var(--crimson); border-color: #EBD9B4; color: var(--cream); }
  .hint { margin: 14px 0 0; padding: 10px 16px; border-radius: 12px; background: #FFFBF2; border: 1px dashed var(--brass); font-size: 13px; color: var(--muted); }
  .results { display: flex; flex-direction: column; gap: 18px; margin-top: 18px; }
  .card { background: #fff; border: 2px solid #D9B98C; border-left: 8px solid var(--c); border-radius: 18px; overflow: hidden; box-shadow: 0 3px 0 var(--brass), 0 10px 24px rgba(74,47,30,.12); }
  .card-head { display: flex; align-items: center; gap: 16px; padding: 14px 20px; background: rgba(var(--t), .13); border-bottom: 1px solid rgba(var(--t), .28); }
  .av { flex: none; width: 60px; height: 60px; border-radius: 14px; overflow: hidden; background: #EFE2C8; border: 3px solid var(--brass); box-shadow: 0 0 0 2px var(--c); display: flex; align-items: center; justify-content: center; color: #8A6A3A; }
  .av img { width: 100%; height: 100%; object-fit: cover; }
  .who { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .who a { color: var(--ink); font-size: 21px; line-height: 1.15; }
  .meta { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-2); }
  .n { padding: 5px 12px; border-radius: 999px; background: #fff; border: 1px solid #D9B98C; font-size: 12px; font-weight: 600; color: var(--timber); }
  .hit { padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; border-top: 1px solid #EFE3CC; }
  .hit:first-of-type { border-top: 0; }
  .hit-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sk { font-size: 17px; }
  .match { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 12px; background: #FBF1E4; border: 1px solid #F0D9C2; font-size: 14px; }
  .lv { margin: 0; display: flex; gap: 12px; font-size: 15px; line-height: 1.65; }
  .lvl { flex: none; width: 38px; font: 700 12px/1.9 var(--mono); color: var(--crimson); }
  .nolv { margin: 0 0 0 50px; font-size: 13px; color: var(--muted); }
  details summary { cursor: pointer; font-size: 13px; color: var(--timber); margin-left: 50px; }
  .lac-list { display: flex; flex-direction: column; gap: 10px; }
  .lac { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 14px; background: #fff; border: 1px solid var(--line); }
  .lac a { color: var(--ink); font-size: 17px; }
  .needs { background: #fff; border: 1px solid var(--line); border-radius: 16px; }
  @media (max-width: 600px) { .banner-body { padding: 22px 18px; } .medal { width: 72px; height: 72px; } }
</style>
