---
import '../styles/global.css';
import Pennant from '../components/Pennant.astro';
import { url, WIKI_CREDIT } from '../lib/data';
interface Props { title: string; description?: string; section?: 'characters' | 'lacrimas' | 'effects' | 'search' | 'home'; }
const { title, description = 'Unofficial reference for FAIRY TAIL Wizard Chronicle: wizards, skills, lacrimas and every effect they apply.', section = 'home' } = Astro.props;
// Absolute URLs for link previews (Discord, social sites) and search engines.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('og.jpg'), Astro.site).href;
const fullTitle = section === 'home' ? 'Fairy Tail Wizard Chronicle — Unofficial Wiki' : `${title} · Fairy Tail Wizard Chronicle Wiki`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="icon" href={url('favicon.ico')} sizes="32x32" />
  <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
  <meta name="theme-color" content="#4A2F1E" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Fairy Tail Wizard Chronicle — Unofficial Wiki" />
  <meta property="og:title" content={section === 'home' ? 'Fairy Tail Wizard Chronicle — Unofficial Wiki' : title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Fairy Tail Wizard Chronicle unofficial wiki, with portraits of Natsu, Lucy, Erza, Gray and Wendy" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus+SC&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={url('')}>
        <Pennant width={30} star />
        <span class="brand-name">Fairy Tail Wizard Chronicle<span class="brand-sub">Unofficial wiki</span></span>
      </a>
      <nav class="nav" aria-label="Primary">
        <a href={url('characters/')} aria-current={section === 'characters' ? 'page' : undefined}>Characters</a>
        <a href={url('lacrimas/')} aria-current={section === 'lacrimas' ? 'page' : undefined}>Lacrimas</a>
        <a href={url('effects/')} aria-current={section === 'effects' ? 'page' : undefined}>Effect Finder</a>
      </nav>
      <form class="header-search" action={url('search/')} method="get" role="search">
        <label class="sr-only" for="hdr-q">Search the wiki</label>
        <input id="hdr-q" name="q" type="search" placeholder="Search the wiki…" />
      </form>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <span>Unofficial fan reference. Not affiliated with GOODROID or the FAIRY TAIL rights holders.</span>
      <span>Lv.1–2 skill text for many wizards from <a href={WIKI_CREDIT.href}>{WIKI_CREDIT.name}</a> (<a href={WIKI_CREDIT.licenseHref}>{WIKI_CREDIT.license}</a>), with thanks.</span>
      <span>Game data only — no tier lists or strategy rankings.</span>
    </div>
  </footer>
</body>
</html>
