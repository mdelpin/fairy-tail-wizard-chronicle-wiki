---
import Base from '../../layouts/Base.astro';
import Pennant from '../../components/Pennant.astro';
import { companions, COMPANION_TYPES, raritiesIn, url, initials } from '../../lib/data';

// Newest first (Introduced On), then by name.
const list = companions.slice().sort((a, b) => (b.introducedOn ?? '').localeCompare(a.introducedOn ?? '') || a.name.localeCompare(b.name));
const uniq = (values: (string | null)[]) => [...new Set(values.filter((v): v is string => !!v))];
const types = COMPANION_TYPES.filter((t) => list.some((c) => c.type === t));
const rarities = raritiesIn(list);
const stats = uniq(list.map((c) => c.ownedStat)).sort();
const vias = uniq(list.map((c) => c.introducedVia));
const filters = [
  { key: 'type', label: 'Type', values: types as readonly string[] },
  { key: 'rarity', label: 'Rarity', values: rarities },
  { key: 'stat', label: 'Bonus', values: stats },
  { key: 'via', label: 'Introduced via', values: vias },
].filter((f) => f.values.length > 1);
---
<Base title="Companions" section="companions" description="Every Celestial Spirit, Exceed and Dragon in FAIRY TAIL Wizard Chronicle, filterable by type, rarity, bonus stat and how it was introduced.">
  <div class="wrap">
    <div class="head">
      <Pennant width={34} star />
      <div>
        <h1>Companions</h1>
        <p class="muted"><span id="shown">{list.length}</span> of {list.length} companions<span id="active" hidden> · <button type="button" class="clear">Clear filters</button></span></p>
      </div>
    </div>
    <p class="muted availability">Each team has one Celestial Spirit, one Exceed and one Dragon. Introduction details are how each card first arrived; as of Nov 2026 companions can appear in companion event gachas, roulette and the medal shop.</p>

    <div class="filters panel">
      <label class="sr-only" for="f-q">Filter by name</label>
      <input id="f-q" type="search" placeholder="Filter by name" />
      {filters.map((f) => (
        <div class="row" role="group" aria-label={f.label}>
          <span class="lbl">{f.label}</span>
          <button type="button" class="pill" data-filter={f.key} data-value="" aria-pressed="true">All</button>
          {f.values.map((v) => <button type="button" class="pill" data-filter={f.key} data-value={v} aria-pressed="false">{v}</button>)}
        </div>
      ))}
    </div>

    <ul class="cards" id="cards">
      {list.map((c) => (
        <li data-name={`${c.name} ${c.identity ?? ''}`.toLowerCase()} data-type={c.type ?? ''} data-rarity={c.rarity ?? ''} data-stat={c.ownedStat ?? ''} data-via={c.introducedVia ?? ''}>
          <a class="card" href={url(`companions/${c.id}/`)}>
            <span class="art">
              {c.image ? <img src={url(`companions/${c.image}`)} alt="" width="320" height="320" loading="lazy" /> : <span aria-hidden="true" class="heading placeholder">{initials(c.name)}</span>}
              {c.rarity && <span class={`rarity rarity-${c.rarity}`}>{c.rarity}</span>}
            </span>
            <span class="body">
              <span class="heading name">{c.name}</span>
              <span class="meta">{[c.type, c.ownedStat && `${c.ownedStat} bonus`].filter(Boolean).join(' · ')}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p id="none" class="muted" hidden>No companions match. <button type="button" class="clear">Clear filters</button></p>
    {list.length === 0 && <p class="muted">Companion entries are in preparation.</p>}
  </div>
</Base>

<script>
  const q = document.getElementById('f-q') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLLIElement>('#cards li')];
  const pills = [...document.querySelectorAll<HTMLButtonElement>('.pill')];
  const keys = ['type', 'rarity', 'stat', 'via'];
  const params = new URLSearchParams(location.search);
  const state: Record<string, string | null> = Object.fromEntries(keys.map((k) => [k, params.get(k)]));
  q.value = params.get('q') ?? '';
  function apply() {
    const text = q.value.trim().toLowerCase();
    let n = 0;
    for (const li of items) {
      const ok = (!text || li.dataset.name!.includes(text)) && keys.every((k) => !state[k] || li.dataset[k] === state[k]);
      li.hidden = !ok;
      if (ok) n++;
    }
    for (const p of pills) p.setAttribute('aria-pressed', String((state[p.dataset.filter!] ?? '') === p.dataset.value));
    document.getElementById('shown')!.textContent = String(n);
    document.getElementById('none')!.hidden = n > 0;
    // Offer Clear only while something narrows the list; keep the address bar in step with the page.
    document.getElementById('active')!.hidden = !(text || keys.some((k) => state[k])) || n === 0;
    const next = new URLSearchParams();
    if (q.value.trim()) next.set('q', q.value.trim());
    for (const k of keys) if (state[k]) next.set(k, state[k]!);
    const s = next.toString();
    history.replaceState(null, '', location.pathname + (s ? '?' + s : '') + location.hash);
  }
  document.querySelectorAll('.clear').forEach((b) => b.addEventListener('click', () => {
    q.value = '';
    for (const k of keys) state[k] = null;
    apply();
    q.focus();
  }));
  for (const p of pills) p.addEventListener('click', () => {
    state[p.dataset.filter!] = p.dataset.value || null;
    apply();
  });
  q.addEventListener('input', apply);
  apply();
</script>

<style>
  .head { display: flex; align-items: center; gap: 16px; margin-bottom: 12px; }
  .head h1 { font-size: 42px; line-height: 1; }
  .head p { margin: 4px 0 0; }
  .availability { margin: 0 0 20px; }
  .clear { padding: 0; border: 0; background: none; color: var(--crimson); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; }
  .clear:hover { color: var(--crimson-dark); }
  .filters { padding: 18px; border-width: 2px; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 3px 0 var(--brass-dark); }
  .filters input { height: 46px; padding: 0 18px; border-radius: 999px; border: 2px solid var(--line); background: #fff; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .lbl { width: 110px; font-size: 13px; font-weight: 700; color: var(--timber); }
  .pill { min-height: 38px; padding: 0 14px; border-radius: 999px; border: 2px solid var(--line); background: #fff; color: var(--ink); font: 600 13px var(--body); cursor: pointer; }
  .pill[aria-pressed='true'] { background: var(--crimson); border-color: #EBD9B4; color: var(--cream); }
  .cards { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; }
  .card { display: flex; flex-direction: column; height: 100%; border: 2px solid var(--line); border-top: 5px solid var(--brass); border-radius: 16px; overflow: hidden; background: #fff; color: var(--ink); box-shadow: 0 3px 0 var(--brass); }
  .card:hover { text-decoration: none; transform: translateY(-2px); }
  .art { position: relative; aspect-ratio: 1; display: grid; place-items: center; background: #F3E8D3; }
  .art img { width: 100%; height: 100%; object-fit: contain; }
  .placeholder { color: var(--timber); font-size: 42px; }
  .rarity { position: absolute; left: 10px; top: 10px; }
  .body { padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; }
  .name { font-size: 17px; line-height: 1.2; }
  .meta { font-size: 13px; color: var(--muted); }
  @media (max-width: 560px) { .lbl { width: 100%; } }
</style>
