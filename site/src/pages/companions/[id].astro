---
import Base from '../../layouts/Base.astro';
import Pennant from '../../components/Pennant.astro';
import {
  bannerById, companions, companionApplications, effects, familyKey, baseName, valueText, dayText, url,
  type Companion,
} from '../../lib/data';

export function getStaticPaths() {
  return companions.map((companion) => ({ params: { id: companion.id }, props: { companion } }));
}

const { companion: c } = Astro.props as { companion: Companion };
const banner = c.introducedBanner ? bannerById.get(c.introducedBanner) : undefined;
const rows = c.applications.flatMap((id) => companionApplications.get(id) ?? []).map((app) => {
  const e = app.effect ? effects.get(app.effect) : undefined;
  return { app, e, fk: e ? familyKey(e) : null };
});
const levels = (['Lv1', 'Lv2', 'Lv3'] as const).filter((k) => c.gameText[k]);
// Same identity word, same companion type only: a Dragon never pairs with a wizard or with another type.
const sameIdentity = companions.filter((o) => o.type === c.type && o.identity && o.identity === c.identity && o.id !== c.id)
  .sort((a, b) => (b.introducedOn ?? '').localeCompare(a.introducedOn ?? '') || a.name.localeCompare(b.name));
const number = new Intl.NumberFormat('en-US', { maximumFractionDigits: 6, signDisplay: 'exceptZero' });
const stepKnown = c.ownedStart != null && c.ownedStep != null;
const introduced = [c.introducedVia, c.introducedOn && `${dayText(c.introducedOn)} JST`].filter(Boolean).join(' · ');
---
<Base title={c.name} section="companions" description={`${c.name}: ${[c.rarity, c.type].filter(Boolean).join(' ')} in FAIRY TAIL Wizard Chronicle. Skill, star progression and introduction.`}>
  <article class="wrap" data-pagefind-body data-pagefind-meta={`title:${c.name}`}>
    <span hidden data-pagefind-filter="Type">Companion</span>
    {c.rarity && <span hidden data-pagefind-filter="Rarity">{c.rarity}</span>}
    <nav class="crumbs" data-pagefind-ignore aria-label="Breadcrumb">
      <a href={url('companions/')}>Companions</a>
      {c.type && <><span aria-hidden="true">/</span><a href={url(`companions/?type=${encodeURIComponent(c.type)}`)}>{c.type}</a></>}
    </nav>

    <header class="panel overview">
      {c.image && <img src={url(`companions/${c.image}`)} alt="" width="160" height="160" data-pagefind-meta="image[src]" />}
      <div>
        <h1>{c.name}</h1>
        <div class="labels">
          {c.rarity && <span class={`rarity rarity-${c.rarity}`}>{c.rarity}</span>}
          {c.type && <span class="muted">{c.type}</span>}
          {c.ownedStat && <span class="muted">· {c.ownedStat} bonus</span>}
        </div>
        <p class="introduced">
          <strong>Introduced</strong>
          {introduced || banner ? (
            <span>{introduced}
              {banner && <a href={url(`banners/#${banner.id}`)}>{banner.name}</a>}
            </span>
          ) : <span class="muted">Details pending.</span>}
        </p>
      </div>
    </header>

    <div class="cols">
      <div class="main">
        <section>
          <div class="section-title"><Pennant /><h2>{c.skillName ?? 'Skill'}</h2></div>
          {levels.length > 0 ? (
            <div class="levels">
              {levels.map((k) => (
                <div class="entry"><h3>Lv.{k.slice(2)}</h3><p>{c.gameText[k]}</p></div>
              ))}
            </div>
          ) : <p class="muted">Skill text pending.</p>}
          {c.levelTextSource === 'Corrected from Japanese text' && (
            <p class="snote" data-pagefind-ignore><span class="nl">Note</span>The English game text for this skill is cut off, so the full text here is corrected from the Japanese client.</p>
          )}
          {c.issues.map((i) => <p class="snote sissue"><span class="nl">Known issue{i.problemType ? ` · ${i.problemType}` : ''}</span>{i.note}</p>)}

          {rows.length > 0 && (
            <div class="entry table-wrap" data-pagefind-ignore>
              <table class="fx">
                <thead><tr><th scope="col">Effect</th><th scope="col">Target</th><th scope="col">Trigger</th><th scope="col">Duration (Lv.1)</th><th scope="col">Value</th></tr></thead>
                <tbody>
                  {rows.map(({ app, e, fk }) => (
                    <tr>
                      <td>
                        <span class={`tier tier-${e?.tier ?? 'none'}`}>{e?.tier ?? '—'}</span>{' '}
                        {fk ? <a href={url(`effects/${fk.key}/#companions`)}><strong>{e ? baseName(e) : '—'}</strong></a> : <strong>{e ? baseName(e) : '—'}</strong>}
                      </td>
                      <td>{app.target ?? '—'}</td>
                      <td>{app.trigger?.raw ?? '—'}</td>
                      <td>{app.durationSeconds == null ? '—' : `${app.durationSeconds}s`}</td>
                      <td>{valueText(app, e)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        <section data-pagefind-ignore>
          <div class="section-title"><Pennant /><h2>Star progression</h2></div>
          <p class="muted summary">
            {stepKnown
              ? <>Owned bonus: {number.format(c.ownedStart!)}% {c.ownedStat ?? ''} at 0 stars, +{c.ownedStep}% for each star.</>
              : c.ownedStart != null ? <>Owned bonus: {number.format(c.ownedStart)}% {c.ownedStat ?? ''} at 0 stars. The step per star is not recorded yet.</> : <>Owned bonus not recorded yet.</>}
            {' '}Skill Lv.2 unlocks at ★{c.skillLevelFromStars[1]}, Lv.3 at red ★2 (★{c.skillLevelFromStars[2]}).
          </p>
          {c.stepConfirmed === false && <p class="snote"><span class="nl">Note</span>The step per star is inferred from the starting value, not yet seen in game.</p>}
        </section>
      </div>

      {sameIdentity.length > 0 && (
        <aside class="side" data-pagefind-ignore>
          <div class="pinboard">
            <span class="heading">Same identity</span>
            {sameIdentity.map((o, i) => (
              <a class="pin" href={url(`companions/${o.id}/`)} style={`transform:rotate(${i % 2 ? 0.5 : -0.6}deg)`}>{o.name}</a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </article>
</Base>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--muted); margin-bottom: 18px; }
  .overview { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; padding: 22px; }
  .overview img { width: min(130px, 100%); height: auto; aspect-ratio: 1; object-fit: contain; }
  h1 { font-size: clamp(32px, 5vw, 48px); line-height: 1.1; }
  .labels { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 8px; }
  .introduced { margin: 14px 0 0; font-size: 14px; }
  .introduced > span, .introduced a { display: block; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 28px; align-items: start; margin-top: 24px; }
  .cols:not(:has(.side)) { grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 860px) { .cols { grid-template-columns: minmax(0, 1fr); } }
  .levels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .entry { border: 1px solid var(--line); border-radius: 14px; background: #fff; }
  .levels .entry { padding: 14px 16px; }
  .levels p { margin: 6px 0 0; }
  .snote { margin: 12px 0 0; padding: 8px 12px; border-radius: 8px; background: #FBF4E7; border-left: 3px solid var(--brass); font-size: 13px; line-height: 1.55; color: #3A2A1F; }
  .sissue { border-left-color: var(--crimson); }
  .snote .nl { display: block; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--timber); }
  .table-wrap { margin-top: 14px; }
  .summary { margin: 0 0 10px; }
  .pinboard { padding: 22px; border-radius: 18px; background: var(--ember); border: 3px solid var(--brass); display: flex; flex-direction: column; gap: 10px; }
  .pinboard .heading { color: #FFF3E0; font-size: 18px; }
  .pin { padding: 10px 12px; border-radius: 6px; background: #FFFBF2; color: var(--ink); font-size: 14px; box-shadow: 0 2px 0 rgba(40,10,6,.4); }
</style>
