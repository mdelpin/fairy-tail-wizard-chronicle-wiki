---
import Base from '../../layouts/Base.astro';
import Pennant from '../../components/Pennant.astro';
import { enemies, events, initials, url } from '../../lib/data';
---
<Base title="Enemies" section="enemies" description="Enemy skills and event appearances in FAIRY TAIL Wizard Chronicle.">
  <div class="wrap">
    <div class="head"><Pennant width={34} star /><h1>Enemies</h1></div>
    <p class="muted">{enemies.length} recorded. Skills and event appearances.</p>
    <ul class="cards">
      {enemies.map((enemy) => {
        const classification = [enemy.type, enemy.role].filter(Boolean).join(' · ');
        const appearances = enemy.events.flatMap((id) => events.get(id) ?? []);
        return (
          <li class="card">
            <div class="art">
              {enemy.image ? <img src={url(`enemies/${enemy.image}`)} alt="" width="64" height="64" loading="lazy" /> : <span class="heading placeholder" aria-hidden="true">{initials(enemy.name)}</span>}
            </div>
            <div class="body">
              <h2><a class="enemy-link" href={url(`enemies/${enemy.id}/`)}>{enemy.name}</a></h2>
              {classification && <span class="muted">{classification}</span>}
              {enemy.trials?.map((trial) => <span>{trial}</span>)}
              {appearances.map((event) => (
                <a class="event-link" href={url(`events/#${event.id}`)}>{event.name}</a>
              ))}
            </div>
          </li>
        );
      })}
    </ul>
    {enemies.length === 0 && <p class="muted">Enemy entries are in preparation.</p>}
  </div>
</Base>

<style>
  .head { display: flex; align-items: center; gap: 16px; }
  h1 { font-size: 42px; line-height: 1; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 12px; list-style: none; padding: 0; margin: 18px 0 0; }
  .card { position: relative; display: grid; grid-template-columns: 64px minmax(0, 1fr); align-items: center; gap: 12px; padding: 10px; border: 2px solid var(--line); border-top: 3px solid var(--crimson); border-radius: 12px; background: #fff; box-shadow: 0 3px 0 var(--brass); }
  .art { display: grid; place-items: center; width: 64px; height: 64px; overflow: hidden; border-radius: 8px; background: var(--timber); }
  .art img { width: 64px; height: 64px; object-fit: contain; }
  .placeholder { font-size: 22px; }
  .body { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; font-size: 14px; line-height: 1.3; overflow-wrap: anywhere; }
  h2 { font-size: 20px; line-height: 1.15; }
  .enemy-link { color: var(--ink); }
  .enemy-link:hover { color: var(--crimson); }
  .enemy-link::after { content: ''; position: absolute; inset: 0; border-radius: 10px; }
  .event-link { position: relative; text-decoration: underline; }
</style>
